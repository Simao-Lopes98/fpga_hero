# PCF for the SoC with a softcore RISC-V module

# Oscilator
set_io              clk             21

# LEDs
set_io              led[0]          99
set_io              led[1]          98
set_io              led[2]          97
set_io              led[3]          96
set_io              led[4]           95

# PMOD I/O
set_io -pullup yes  reset           78
set_io              rx              79
set_io              tx              80
