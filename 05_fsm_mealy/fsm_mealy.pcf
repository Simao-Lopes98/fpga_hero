# PCF for the FSM_MEALY module

# Oscilator
set_io              clk              21

# LEDs
set_io              led[0]           99
set_io              led[1]           98
set_io              led[2]           97
set_io              led[3]           96
set_io              done_sig         95

# PMOD I/O
set_io -pullup yes  pmod[0]          78
set_io -pullup yes  pmod[1]          79

